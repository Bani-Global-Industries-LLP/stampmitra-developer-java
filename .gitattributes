* text=auto eol=lf

# Keep the GitHub source archive lean; the Maven Central sources jar comes from maven-source-plugin.
/.github/ export-ignore
/.editorconfig export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/config/ export-ignore
/examples/ export-ignore
/scripts/ export-ignore
/spec/ export-ignore
/CONTRIBUTING.md export-ignore
/CODE_OF_CONDUCT.md export-ignore
/RELEASING.md export-ignore

# Generated sources: collapse diffs on GitHub.
/src/main/java/in/stampmitra/sdk/models/*.java linguist-generated=true
/src/main/java/in/stampmitra/sdk/requests/*.java linguist-generated=true
/examples/src/main/java/in/stampmitra/examples/ReadmeSnippets.java linguist-generated=true
